# Generate a unique value before starting. Do not commit the resulting .env.
SEARXNG_SECRET=

# Absolute private directory outside the MCP source checkout; see deployment guide.
SEARXNG_SETTINGS_DIR=

# Absolute source checkout. These are Compose inputs, not MCP runtime variables.
MCP_SOURCE_DIR=
# Optional defaults; use distinct values for a parallel candidate project.
MCP_IMAGE=mcp-searxng-search:local
SEARXNG_HOST_PORT=18089
MCP_HOST_PORT=18300
